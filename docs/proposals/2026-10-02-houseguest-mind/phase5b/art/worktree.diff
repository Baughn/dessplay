+    /// Every dial and sky inks enough of its footprint, and is drawn the
+    /// same whichever way it was asked to face (a mirrored dial reads
+    /// 3:00 as 9:00).
+    #[test]
+    fn every_dial_and_sky_renders_inside_its_footprint_unmirrored() {
+        let inked = |image: &image::RgbaImage| image.pixels().filter(|p| p.0[3] > 0).count() as u32;
+        for art in [&CLOCK, &CLOCK4] {
+            let (w, h) = ((art.frame.0 * 0.45) as u32, 38);
+            for minute in (0..24 * 60).step_by(15) {
+                let dial = Dial::at(minute);
+                let [right, left] = [Facing::Right, Facing::Left]
+                    .map(|facing| rasterize(&dial_scene(art, dial, facing, LINE), art.frame, w, h));
+                let right = right.expect("renders");
+                assert!(inked(&right) > w * h / 6, "{} {dial:?}", art.prefix);
+                assert_eq!(Some(right), left, "{} {dial:?}", art.prefix);
+            }
+        }
+        // Each quarter of a 12-hour day is its own face.
+        let faces: std::collections::HashSet<_> = (0..12 * 60)
+            .step_by(15)
+            .map(|minute| {
+                rasterize(
+                    &dial_scene(&CLOCK, Dial::at(minute), Facing::Right, LINE),
+                    CLOCK.frame,
+                    27,
+                    38,
+                )
+                .expect("renders")
+                .into_raw()
+            })
+            .collect();
+        assert_eq!(faces.len(), 48);
+        for (prefix, frame, (w, h)) in [
+            ("window", (80.0, 84.0), (36, 38)),
+            ("window5", (100.0, 126.0), (45, 57)),
+        ] {
+            for sky in Sky::ALL {
+                let [right, left] = [Facing::Right, Facing::Left].map(|facing| {
+                    rasterize(&window_scene(prefix, frame, sky, facing, LINE), frame, w, h)
+                });
+                let right = right.expect("renders");
+                assert!(inked(&right) > w * h / 6, "{prefix} {sky:?}");
+                assert_eq!(Some(right), left, "{prefix} {sky:?}");
+            }
+        }
+    }
