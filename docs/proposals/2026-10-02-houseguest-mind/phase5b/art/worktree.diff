+    /// The wall clock and the window for review (phase 5b):
+    /// `HOUSEGUEST_CLOCK=/dir cargo test -p dessplay --lib clock_sheet --
+    /// --ignored` writes `clock-window-1x.png`, the same pixels at 3×
+    /// nearest-neighbour (`clock-window-1x-nn3x.png`) and a native 3×
+    /// render (`clock-window-3x.png`), over a dark terminal. Hung pieces
+    /// render at exactly their footprint, as the game draws a piece off
+    /// the floor line. Bands, top to bottom:
+    /// 1. the 4 × 2 window in its five skies (night, dawn, day, dusk,
+    ///    evening), then night asked for facing left;
+    /// 2. the 5 × 3 window, the same;
+    /// 3. the 3 × 2 dial at 12 hours (columns 12, 1, …, 11) × 4 quarters
+    ///    (rows :00, :15, :30, :45);
+    /// 4. the 4 × 2 dial, the same;
+    /// 5. facings: each clock at 3:00 facing right, asked for facing left
+    ///    (normalised: identical), and naively mirrored (reads 9:00;
+    ///    underlined red), then the window at dusk both ways;
+    /// 6. the context: both pieces hung beside the poster over the sofa,
+    ///    her in `Gaze` under the window, at 16:00 (day) and 23:00
+    ///    (night); then the 4 × 2 clock and 5 × 3 window at 18:45 (dusk).
+    #[test]
+    #[ignore = "writes PNGs for review"]
+    fn clock_sheet() {
+        enum Draw {
+            /// An SVG in `frame` units over `cols × rows` cells at (x, y);
+            /// standing pieces get the floor row's half cell too, and `y`
+            /// is then their floor row.
+            Svg {
+                svg: String,
+                frame: (f32, f32),
+                at: (u32, u32),
+                size: (u32, u32),
+                standing: bool,
+            },
+            /// Her box (5 × 4) at column `x`, on floor row `y`.
+            Her(Rig, Facing, (u32, u32)),
+            /// A floor line on row `y` from column `x0` to `x1`.
+            Floor(u32, u32, u32),
+            /// A red underline below row `y`, columns `x0..x1`.
+            Wrong(u32, u32, u32),
+        }
+        const BG: image::Rgba<u8> = image::Rgba([30, 33, 39, 255]);
+        const FLOOR: image::Rgba<u8> = image::Rgba([139, 148, 158, 255]);
+        const RED: image::Rgba<u8> = image::Rgba([224, 82, 82, 255]);
+        let dir = std::env::var("HOUSEGUEST_CLOCK").expect("HOUSEGUEST_CLOCK");
+        /// A window's group prefix, frame in units and footprint in cells.
+        type WindowArt = (&'static str, (f32, f32), (u32, u32));
+        const WINDOW4: WindowArt = ("window", (80.0, 84.0), (4, 2));
+        const WINDOW5: WindowArt = ("window5", (100.0, 126.0), (5, 3));
+        let clock_size = |art: &ClockArt| ((art.frame.0 / 20.0) as u32, 2);
+        let window = |w: WindowArt, sky, facing, at| Draw::Svg {
+            svg: window_scene(w.0, w.1, sky, facing, LINE),
+            frame: w.1,
+            at,
+            size: w.2,
+            standing: false,
+        };
+        let dial = |art: &ClockArt, d: Dial, facing, at| Draw::Svg {
+            svg: dial_scene(art, d, facing, LINE),
+            frame: art.frame,
+            at,
+            size: clock_size(art),
+            standing: false,
+        };
+        let mut draws = Vec::new();
+        // 1–2. The windows.
+        for (i, sky) in Sky::ALL.into_iter().enumerate() {
+            draws.push(window(WINDOW4, sky, Facing::Right, (1 + 5 * i as u32, 1)));
+            draws.push(window(WINDOW5, sky, Facing::Right, (1 + 6 * i as u32, 4)));
+        }
+        draws.push(window(WINDOW4, Sky::Night, Facing::Left, (27, 1)));
+        draws.push(window(WINDOW5, Sky::Night, Facing::Left, (32, 4)));
+        // 3–4. Every dial.
+        for quarter in 0..4u8 {
+            for hour in 0..12u8 {
+                let d = Dial { hour, quarter };
+                let (h, q) = (u32::from(hour), u32::from(quarter));
+                draws.push(dial(&CLOCK, d, Facing::Right, (1 + 4 * h, 8 + 3 * q)));
+                draws.push(dial(&CLOCK4, d, Facing::Right, (1 + 5 * h, 21 + 3 * q)));
+            }
+        }
+        // 5. Facings.
+        let three = Dial {
+            hour: 3,
+            quarter: 0,
+        };
+        for (art, x) in [(&CLOCK, 1u32), (&CLOCK4, 14)] {
+            let (cols, _) = clock_size(art);
+            draws.push(dial(art, three, Facing::Right, (x, 34)));
+            draws.push(dial(art, three, Facing::Left, (x + cols + 1, 34)));
+            // What render_piece's mirror group would have drawn.
+            let (w, h) = art.frame;
+            let naive = format!(
+                r##"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {w} {h}" color="{LINE}">{PROPS}<g transform="translate({w} 0) scale(-1 1)">{}</g></svg>"##,
+                dial_parts(art, three)
+            );
+            let nx = x + 2 * (cols + 1);
+            draws.push(Draw::Svg {
+                svg: naive,
+                frame: art.frame,
+                at: (nx, 34),
+                size: (cols, 2),
+                standing: false,
+            });
+            draws.push(Draw::Wrong(36, nx, nx + cols));
+        }
+        draws.push(window(WINDOW4, Sky::Dusk, Facing::Right, (30, 34)));
+        draws.push(window(WINDOW4, Sky::Dusk, Facing::Left, (35, 34)));
+        // 6. The context strips: floor on row 44, hung pieces' bottom
+        // row at floor − 5 (hang 4).
+        let floor = 44u32;
+        let gaze = Rig::for_pose(Pose::Gaze, Face::Curious);
+        let strips: [(u32, &ClockArt, WindowArt, Dial, Sky); 3] = [
+            (0, &CLOCK, WINDOW4, Dial::at(16 * 60), Sky::Day),
+            (20, &CLOCK, WINDOW4, Dial::at(23 * 60), Sky::Night),
+            (40, &CLOCK4, WINDOW5, Dial::at(18 * 60 + 45), Sky::Dusk),
+        ];
+        for (x, art, win, d, sky) in strips {
+            let hung = |rows: u32| floor - 4 - rows;
+            draws.push(Draw::Floor(floor, x + 1, x + 20));
+            draws.push(Draw::Svg {
+                svg: layer_scene(Furniture::Sofa, Layer::Whole, Facing::Right, LINE),
+                frame: prop_frame(Furniture::Sofa),
+                at: (x + 1, floor),
+                size: (9, 3),
+                standing: true,
+            });
+            draws.push(Draw::Svg {
+                svg: layer_scene(Furniture::Poster, Layer::Whole, Facing::Right, LINE),
+                frame: prop_frame(Furniture::Poster),
+                at: (x + 1, hung(2)),
+                size: (4, 2),
+                standing: false,
+            });
+            let (cols, _) = clock_size(art);
+            draws.push(dial(art, d, Facing::Left, (x + 6, hung(2))));
+            let wx = x + 7 + cols;
+            draws.push(window(win, sky, Facing::Left, (wx, hung(win.2.1))));
+            // Her box a little left of the window's middle, facing it.
+            let mid = wx + win.2.0 / 2;
+            draws.push(Draw::Her(gaze, Facing::Right, (mid - 3, floor)));
+        }
+        let (cols, rows) = (62u32, 46u32);
+        let render_sheet = |s: u32| {
+            let (w, h) = (9 * s, 19 * s);
+            let mut sheet = image::RgbaImage::from_pixel(w * cols, h * rows, BG);
+            for draw in &draws {
+                match draw {
+                    Draw::Svg {
+                        svg,
+                        frame,
+                        at,
+                        size,
+                        standing,
+                    } => {
+                        let (pw, mut ph) = (w * size.0, h * size.1);
+                        let mut top = h * at.1;
+                        if *standing {
+                            ph += h / 2;
+                            top = h * (at.1 - size.1);
+                        }
+                        let image = rasterize(svg, *frame, pw, ph).expect("renders");
+                        image::imageops::overlay(
+                            &mut sheet,
+                            &image,
+                            i64::from(w * at.0),
+                            i64::from(top),
+                        );
+                    }
+                    Draw::Her(rig, facing, (x, y)) => {
+                        let osaka = render(rig, *facing, LINE, w * 5, h * 4 + h / 2).unwrap();
+                        image::imageops::overlay(
+                            &mut sheet,
+                            &osaka,
+                            i64::from(w * x),
+                            i64::from(h * (y - 4)),
+                        );
+                    }
+                    Draw::Floor(y, x0, x1) => {
+                        for gx in w * x0..w * x1 {
+                            for t in 0..s {
+                                sheet.put_pixel(gx, h * y + h / 2 + t, FLOOR);
+                            }
+                        }
+                    }
+                    Draw::Wrong(y, x0, x1) => {
+                        for gx in w * x0..w * x1 {
+                            for t in 0..s {
+                                sheet.put_pixel(gx, h * y + 2 * s + t, RED);
+                            }
+                        }
+                    }
+                }
+            }
+            sheet
+        };
+        let one = render_sheet(1);
+        one.save(format!("{dir}/clock-window-1x.png")).unwrap();
+        image::imageops::resize(
+            &one,
+            one.width() * 3,
+            one.height() * 3,
+            image::imageops::FilterType::Nearest,
+        )
+        .save(format!("{dir}/clock-window-1x-nn3x.png"))
+        .unwrap();
+        render_sheet(3)
+            .save(format!("{dir}/clock-window-3x.png"))
+            .unwrap();
+    }
