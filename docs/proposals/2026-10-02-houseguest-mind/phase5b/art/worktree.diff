+/// The wall clock's dial, to the quarter-hour: `hour` 0–11, `quarter`
+/// 0–3. 48 faces in all.
+#[cfg_attr(not(test), allow(dead_code))]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(super) struct Dial {
+    pub hour: u8,
+    pub quarter: u8,
+}
+
+#[cfg_attr(not(test), allow(dead_code))]
+impl Dial {
+    /// The dial showing `minute` of the day, rounded down to its quarter.
+    pub(super) fn at(minute: u16) -> Self {
+        Self {
+            hour: (minute / 60 % 12) as u8,
+            quarter: (minute % 60 / 15) as u8,
+        }
+    }
+
+    /// The hour and minute hands' angles, clockwise from 12.
+    fn angles(self) -> (f32, f32) {
+        let quarter = f32::from(self.quarter % 4);
+        (
+            f32::from(self.hour % 12) * 30.0 + quarter * 7.5,
+            quarter * 90.0,
+        )
+    }
+}
+
+/// A wall clock's art: its SVG group prefix (`{prefix}`, then
+/// `{prefix}-hand-hour`, `-hand-minute`, `-pin`), frame and face centre
+/// in units.
+#[cfg_attr(not(test), allow(dead_code))]
+struct ClockArt {
+    prefix: &'static str,
+    frame: (f32, f32),
+    centre: (f32, f32),
+}
+
+/// The 3 × 2 clock (the face centre sits on a pixel centre at 9 × 19, so
+/// its 1-px hands are crisp at 12, 3, 6 and 9).
+#[cfg_attr(not(test), allow(dead_code))]
+const CLOCK: ClockArt = ClockArt {
+    prefix: "clock",
+    frame: (60.0, 84.0),
+    centre: (30.0, 42.888_89),
+};
+
+/// The 4 × 2 clock, for comparison (its centre sits on a pixel corner,
+/// for 2-px hands).
+#[cfg_attr(not(test), allow(dead_code))]
+const CLOCK4: ClockArt = ClockArt {
+    prefix: "clock4",
+    frame: (80.0, 84.0),
+    centre: (40.0, 44.0),
+};
+
+/// The clock's parts showing `dial`, back to front, unmirrored.
+#[cfg_attr(not(test), allow(dead_code))]
+fn dial_parts(art: &ClockArt, dial: Dial) -> String {
+    let (hour, minute) = dial.angles();
+    let (cx, cy) = art.centre;
+    let p = art.prefix;
+    format!(
+        r##"<use href="#{p}"/><use href="#{p}-hand-hour" transform="rotate({hour} {cx} {cy})"/><use href="#{p}-hand-minute" transform="rotate({minute} {cx} {cy})"/><use href="#{p}-pin"/>"##
+    )
+}
+
+/// The clock showing `dial`, as an SVG document in its frame. It is
+/// never mirrored, whatever way it was hung: a mirrored dial would read
+/// 3:00 as 9:00.
+#[cfg_attr(not(test), allow(dead_code))]
+fn dial_scene(art: &ClockArt, dial: Dial, _facing: Facing, line: &str) -> String {
+    let (w, h) = art.frame;
+    format!(
+        r##"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {w} {h}" color="{line}">{PROPS}{}</svg>"##,
+        dial_parts(art, dial)
+    )
+}
+
+/// The sky through the window, by the time of day.
+#[cfg_attr(not(test), allow(dead_code))]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(super) enum Sky {
+    Night,
+    Dawn,
+    Day,
+    Dusk,
+    Evening,
+}
+
+#[cfg_attr(not(test), allow(dead_code))]
+impl Sky {
+    const ALL: [Self; 5] = [
+        Self::Night,
+        Self::Dawn,
+        Self::Day,
+        Self::Dusk,
+        Self::Evening,
+    ];
+
+    fn id(self) -> &'static str {
+        match self {
+            Self::Night => "night",
+            Self::Dawn => "dawn",
+            Self::Day => "day",
+            Self::Dusk => "dusk",
+            Self::Evening => "evening",
+        }
+    }
+}
+
+/// The window (group `prefix`, frame `frame`) with `sky` behind its
+/// glass, as an SVG document. Static parts: the sky group clips itself to
+/// `{prefix}-glass`. Never mirrored.
+#[cfg_attr(not(test), allow(dead_code))]
+fn window_scene(prefix: &str, frame: (f32, f32), sky: Sky, _facing: Facing, line: &str) -> String {
+    let (w, h) = frame;
+    format!(
+        r##"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {w} {h}" color="{line}">{PROPS}<use href="#{prefix}-sky-{}"/><use href="#{prefix}"/></svg>"##,
+        sky.id()
+    )
+}
