+    /// The gremlin figurine for review (phase 6, not wired in):
+    /// `HOUSEGUEST_GREMLIN=/dir cargo test -p dessplay --lib gremlin_sheet
+    /// -- --ignored` writes `gremlin-1x.png`, the same pixels at 3×
+    /// nearest-neighbour (`gremlin-1x-nn3x.png`) and a native 3× render
+    /// (`gremlin-3x.png`). The figurine stands on a shelf, a run of `─`
+    /// drawn as a floor line: rendered as a standing piece, its plinth on
+    /// the line. Bands, top to bottom, each on a dark terminal (#1e2127)
+    /// and then a light one (the outline stays #1d1714 on both):
+    /// 1. on a shelf run: the gremlin facing right, facing left
+    ///    (mirrored), the tall-pedestal variant, the jade variant, the
+    ///    3-wide long-eared variant; then the ASCII candidates (`oo`/`ww`
+    ///    and `/\`/`oo`) in its ink, in the stand-in bitmap font;
+    /// 2. a pane's back wall: the plant on the floor, her standing under
+    ///    a shelf hung just over her head (the floor − 5) with the
+    ///    gremlin on it, the clock and the poster hung beside it (hang 4).
+    #[test]
+    #[ignore = "writes PNGs for review: set HOUSEGUEST_GREMLIN"]
+    fn gremlin_sheet() {
+        type Rgba = image::Rgba<u8>;
+        enum Draw {
+            /// A background from row `y0` to `y1`.
+            Bg(u32, u32, Rgba),
+            /// A piece in a state at (x, y): its top row (hung) or its
+            /// floor row (standing).
+            Piece(Furniture, PieceState, Facing, (u32, u32), bool),
+            /// A `props.svg` group `cols` × 2 cells wide, standing on the
+            /// shelf row `y` at column `x`.
+            Figure(&'static str, u32, Facing, (u32, u32)),
+            /// Her box (5 × 4) at column `x`, on floor row `y`.
+            Her(Rig, Facing, (u32, u32)),
+            /// A floor (or shelf) line on row `y` from column `x0` to `x1`.
+            Line(u32, u32, u32, Rgba),
+            /// ASCII rows from cell (x, y), in a stand-in font.
+            Ascii(&'static [&'static str], (u32, u32), Rgba),
+            /// A dim label.
+            Label(&'static str, (u32, u32), Rgba),
+        }
+        const DARK: Rgba = image::Rgba([30, 33, 39, 255]);
+        const LIGHT: Rgba = image::Rgba([244, 241, 234, 255]);
+        const DARK_LINE: Rgba = image::Rgba([139, 148, 158, 255]);
+        const LIGHT_LINE: Rgba = image::Rgba([110, 118, 129, 255]);
+        const INK: Rgba = image::Rgba([178, 154, 224, 255]);
+        let Ok(dir) = std::env::var("HOUSEGUEST_GREMLIN") else {
+            eprintln!("HOUSEGUEST_GREMLIN unset; nothing written");
+            return;
+        };
+        let cols = 32u32;
+        let mut draws = Vec::new();
+        let mut y0 = 0u32;
+        let stand = Rig::for_pose(Pose::Stand, Face::Vacant);
+        for (band, height) in [("1", 6u32), ("2", 10)] {
+            for (bg, line) in [(DARK, DARK_LINE), (LIGHT, LIGHT_LINE)] {
+                draws.push(Draw::Bg(y0, y0 + height, bg));
+                draws.push(Draw::Label(band, (0, y0), LIGHT_LINE));
+                if band == "1" {
+                    let shelf = y0 + 4;
+                    draws.push(Draw::Line(shelf, 1, 20, line));
+                    for (x, id, wide, facing) in [
+                        (2, "gremlin", 2, Facing::Right),
+                        (5, "gremlin", 2, Facing::Left),
+                        (8, "gremlin-tall", 2, Facing::Right),
+                        (11, "gremlin-jade", 2, Facing::Right),
+                        (14, "gremlin-wide", 3, Facing::Right),
+                    ] {
+                        draws.push(Draw::Figure(id, wide, facing, (x, shelf)));
+                    }
+                    draws.push(Draw::Line(shelf, 22, 30, line));
+                    draws.push(Draw::Ascii(&["oo", "ww"], (23, shelf - 2), INK));
+                    draws.push(Draw::Ascii(&["/\\", "oo"], (27, shelf - 2), INK));
+                } else {
+                    let floor = y0 + height - 1;
+                    let shelf = floor - 5;
+                    draws.push(Draw::Line(floor, 1, 30, line));
+                    draws.push(Draw::Piece(
+                        Furniture::Plant,
+                        PieceState::Plain,
+                        Facing::Right,
+                        (2, floor),
+                        true,
+                    ));
+                    draws.push(Draw::Her(stand, Facing::Right, (7, floor)));
+                    draws.push(Draw::Line(shelf, 7, 12, line));
+                    draws.push(Draw::Figure("gremlin", 2, Facing::Right, (9, shelf)));
+                    draws.push(Draw::Piece(
+                        Furniture::Clock,
+                        PieceState::Dial(Dial::at(16 * 60)),
+                        Facing::Right,
+                        (13, floor - 6),
+                        false,
+                    ));
+                    draws.push(Draw::Piece(
+                        Furniture::Poster,
+                        PieceState::Plain,
+                        Facing::Right,
+                        (17, floor - 6),
+                        false,
+                    ));
+                }
+                y0 += height;
+            }
+        }
+        let rows = y0;
+        let render_sheet = |s: u32| {
+            let (w, h) = (9 * s, 19 * s);
+            let mut sheet = image::RgbaImage::from_pixel(w * cols, h * rows, DARK);
+            let put = |sheet: &mut image::RgbaImage, image: &image::RgbaImage, x: u32, y: u32| {
+                image::imageops::overlay(sheet, image, i64::from(x), i64::from(y));
+            };
+            let text = |sheet: &mut image::RgbaImage, row: &str, (x, y): (u32, u32), ink| {
+                for (i, c) in row.chars().enumerate() {
+                    let (cx, cy) = (w * (x + i as u32) + 2 * s, h * y + 6 * s);
+                    for (r, bits) in glyph(c).into_iter().enumerate() {
+                        for col in 0..5u32 {
+                            if bits >> (4 - col) & 1 == 1 {
+                                for dy in 0..s {
+                                    for dx in 0..s {
+                                        sheet.put_pixel(
+                                            cx + col * s + dx,
+                                            cy + r as u32 * s + dy,
+                                            ink,
+                                        );
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            };
+            for draw in &draws {
+                match draw {
+                    Draw::Bg(a, b, colour) => {
+                        for py in h * a..h * b {
+                            for px in 0..w * cols {
+                                sheet.put_pixel(px, py, *colour);
+                            }
+                        }
+                    }
+                    Draw::Piece(item, state, facing, at, standing) => {
+                        let (pc, pr) = item.spec().footprint;
+                        let (pw, mut ph) = (w * u32::from(pc), h * u32::from(pr));
+                        let mut top = h * at.1;
+                        if *standing {
+                            ph += h / 2;
+                            top = h * (at.1 - u32::from(pr));
+                        }
+                        let image =
+                            render_piece(*item, *state, *facing, LINE, pw, ph).expect("renders");
+                        put(&mut sheet, &image, w * at.0, top);
+                    }
+                    Draw::Figure(id, wide, facing, (x, y)) => {
+                        let (fw, fh) = (*wide as f32 * CELL_UNITS.0, 2.0 * CELL_UNITS.1);
+                        let mirror = match facing {
+                            Facing::Right => String::new(),
+                            Facing::Left => {
+                                format!(r#" transform="translate({fw} 0) scale(-1 1)""#)
+                            }
+                        };
+                        let svg = format!(
+                            r##"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {fw} {fh}" color="{LINE}">{PROPS}<g{mirror}><use href="#{id}"/></g></svg>"##
+                        );
+                        let image =
+                            rasterize(&svg, (fw, fh), w * wide, 2 * h + h / 2).expect("renders");
+                        put(&mut sheet, &image, w * x, h * (y - 2));
+                    }
+                    Draw::Her(rig, facing, (x, y)) => {
+                        let osaka = render(rig, *facing, LINE, w * 5, h * 4 + h / 2).unwrap();
+                        put(&mut sheet, &osaka, w * x, h * (y - 4));
+                    }
+                    Draw::Line(y, x0, x1, colour) => {
+                        for gx in w * x0..w * x1 {
+                            for t in 0..s {
+                                sheet.put_pixel(gx, h * y + h / 2 + t, *colour);
+                            }
+                        }
+                    }
+                    Draw::Ascii(lines, (x, y), ink) => {
+                        for (i, row) in lines.iter().enumerate() {
+                            text(&mut sheet, row, (*x, y + i as u32), *ink);
+                        }
+                    }
+                    Draw::Label(label, at, ink) => text(&mut sheet, label, *at, *ink),
+                }
+            }
+            sheet
+        };
+        let one = render_sheet(1);
+        one.save(format!("{dir}/gremlin-1x.png")).unwrap();
+        image::imageops::resize(
+            &one,
+            one.width() * 3,
+            one.height() * 3,
+            image::imageops::FilterType::Nearest,
+        )
+        .save(format!("{dir}/gremlin-1x-nn3x.png"))
+        .unwrap();
+        render_sheet(3)
+            .save(format!("{dir}/gremlin-3x.png"))
+            .unwrap();
+    }
