+            '!' => [4, 4, 4, 4, 4, 0, 4],
+            '?' => [14, 17, 1, 2, 4, 0, 4],
+            '.' => [0, 0, 0, 0, 0, 0, 4],
+            '\'' => [4, 4, 8, 0, 0, 0, 0],
+            '~' => [0, 0, 8, 21, 2, 0, 0],
+            'M' => [17, 27, 21, 21, 17, 17, 17],
+            'T' => [31, 4, 4, 4, 4, 4, 4],
+            'a' => [0, 0, 14, 1, 15, 17, 15],
+            'b' => [16, 16, 22, 25, 17, 17, 30],
+            'c' => [0, 0, 14, 16, 16, 17, 14],
+            'd' => [1, 1, 13, 19, 17, 17, 15],
