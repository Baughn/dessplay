+            'h' => [16, 16, 22, 25, 17, 17, 17],
+            'i' => [4, 0, 12, 4, 4, 4, 14],
+            'k' => [16, 16, 18, 20, 24, 20, 18],
+            'l' => [12, 4, 4, 4, 4, 4, 14],
+            'm' => [0, 0, 26, 21, 21, 21, 17],
+            'n' => [0, 0, 22, 25, 17, 17, 17],
+            'o' => [0, 0, 14, 17, 17, 17, 14],
+            'r' => [0, 0, 22, 25, 16, 16, 16],
+            's' => [0, 0, 15, 16, 14, 1, 30],
+            't' => [8, 8, 28, 8, 8, 9, 6],
+            'u' => [0, 0, 17, 17, 17, 19, 13],
+            'w' => [0, 0, 17, 17, 21, 21, 10],
