<templates version="1">
  <template name="rogue-inspection">
    <column>
      <text id="rogue-inspection-heading" bind="heading" />
      <text id="rogue-inspection-note" bind="note" if="has-note" />
      <scroll><slot name="body" /></scroll>
    </column>
  </template>
  <template name="rogue-equipment-row"><text class="rogue-equipment-description" bind="description" /></template>
  <template name="rogue-document"><text id="rogue-document" bind="body" /></template>
  <template name="rogue-epitaph">
    <column>
      <text id="epitaph-heading" bind="heading" />
      <text id="epitaph-summary" bind="summary" />
      <text id="epitaph-actions" bind="actions" />
    </column>
  </template>
  <template name="rogue-recovery">
    <box>
      <overlay id="rogue-recovery" placement="center" title="title" title-bottom="footer">
        <text id="recovery-phase" bind="phase" />
        <flow class="recovery-line" separator="  ">
          <flow><text bind="blood-label"/><text bind="blood"/></flow>
          <flow><text bind="breath-label"/><text bind="breath"/></flow>
          <flow><text bind="nutrition-label"/><text bind="nutrition"/></flow>
        </flow>
        <flow class="recovery-line" separator="  ">
          <flow><text bind="bleed-label"/><text bind="bleed"/></flow>
          <flow><text bind="pain-label"/><text bind="pain"/></flow>
        </flow>
        <flow class="recovery-line" separator="  ">
          <flow><text bind="linen-label"/><text bind="linen"/><text bind="linen-used"/></flow>
          <flow><text bind="splints-label"/><text bind="splints"/><text bind="splints-used"/></flow>
          <flow><text bind="food-label"/><text bind="food"/><text bind="food-used"/></flow>
        </flow>
        <slot id="recovery-wounds" name="wounds" />
      </overlay>
    </box>
  </template>
  <template name="rogue">
    <box id="rogue-frame" title="title" title-bottom="footer">
      <text id="rogue-notices" bind="notices" if="has-notices" />
      <text id="rogue-error" bind="error" if="has-error" />
      <slot id="rogue-page" name="body" />
    </box>
  </template>
  <template name="rogue-game">
    <column id="rogue-game">
      <text id="rogue-objective" bind="objective" />
      <row class="rogue-statistics">
        <row class="rogue-metric"><text class="metric-label" bind="depth-label"/><text bind="depth"/></row>
        <row class="rogue-metric"><text class="metric-label" bind="blood-label"/><text bind="blood"/></row>
        <row class="rogue-metric"><text class="metric-label" bind="breath-label"/><text bind="breath"/></row>
        <row class="rogue-metric"><text class="metric-label" bind="pain-label"/><text bind="pain"/></row>
        <row class="rogue-metric"><text class="metric-label" bind="bleed-label"/><text bind="bleed"/></row>
      </row>
      <row class="rogue-statistics rogue-supplies">
        <row class="rogue-metric"><text class="metric-label" bind="linen-label"/><text bind="linen"/></row>
        <row class="rogue-metric"><text class="metric-label" bind="splints-label"/><text bind="splints"/></row>
        <row class="rogue-metric"><text class="metric-label" bind="food-label"/><text bind="food"/></row>
        <row class="rogue-metric"><text class="metric-label" bind="nutrition-label"/><text bind="nutrition"/></row>
        <row class="rogue-metric"><text class="metric-label" bind="gold-label"/><text bind="gold"/></row>
        <text bind="weapon" />
      </row>
      <text id="rogue-reach" bind="reach" if="has-reach" />
      <row id="rogue-exploration">
        <slot id="rogue-map" name="map" />
        <slot id="rogue-sidebar" name="sidebar" if="wide" />
      </row>
      <slot id="rogue-recent-journal" name="journal" />
    </column>
  </template>
  <template name="rogue-condition"><flow class="rogue-condition"><text bind="region"/><text bind="details"/></flow></template>
  <template name="rogue-summary"><column id="rogue-summary"><slot id="summary-wounds" name="wounds"/><slot id="summary-threats" name="threats" if="has-threats"/></column></template>
  <template name="rogue-threat"><flow class="rogue-threat"><prefix separator=""><text bind="name"/><text bind="separator"/></prefix><text bind="intent"/></flow></template>
  <template name="rogue-omission"><flow class="rogue-omission"><text bind="count" if="counted"/><text bind="label"/><text bind="key"/></flow></template>
  <template name="rogue-journal-row"><flow class="rogue-journal-row"><prefix separator=""><text bind="open"/><text bind="time"/><text bind="close"/></prefix><text bind="body"/></flow></template>
  <template name="rogue-recent-event"><text class="rogue-journal-row" bind="body"/></template>
  <template name="rogue-loading"><column><text bind="notice"/><text bind="detail"/></column></template>
</templates>
