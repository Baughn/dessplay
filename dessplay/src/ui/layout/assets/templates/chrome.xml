<templates version="1">
  <template name="status"><column id="status-frame"><flow><text bind="marker"/><text bind="state"/><text bind="blockers" if="blocked"/></flow><flow><text bind="now-label"/><text bind="title" if="has-title"/></flow></column></template>
  <template name="keybar"><repeat id="keybindings" bind="bindings"><use template="keybinding"/></repeat></template>
  <template name="keybinding"><row><text class="key-separator" bind="separator" if="separated"/><flow><text bind="key"/><text bind="label"/></flow></row></template>
  <template name="health"><row id="health-line"><slot name="progress"/><slot id="health-middle-slot" name="middle"/><slot name="metrics"/></row></template>
  <template name="health-progress"><flow id="health-progress" if="available"><prefix separator=""><text bind="open"/><text bind="fill"/><text bind="close"/></prefix><text bind="elapsed"/><text bind="slash"/><text bind="duration"/></flow></template>
  <template name="health-middle"><box id="health-middle"><slot name="marquee" if="animation"/><text bind="body" if="suggestion"/></box></template>
  <template name="health-metrics"><repeat id="health-metrics" bind="metrics"><use template="health-metric"/></repeat></template>
  <template name="health-metric"><row id="health-metric"><text class="health-separator" bind="separator" if="separated"/><flow if="ordinary"><text bind="label"/><text bind="value"/></flow><flow if="suffix"><text bind="value"/><text bind="label"/></flow><row class="health-bandwidth" if="bandwidth"><flow separator=""><text bind="up-marker"/><text bind="upload"/></flow><flow separator=""><text bind="down-marker"/><text bind="download"/></flow></row></row></template>
</templates>
