<templates version="1">
  <template name="form">
    <column id="form" title="title">
      <slot id="form-header" name="header" />
      <scroll id="form-scroll"><slot name="body" /></scroll>
      <slot id="form-notes" name="notes" />
      <slot name="save" />
      <overlay id="form-editor" if="editing">
        <box id="form-editor-frame"><slot name="editor" /></box>
        <slot name="error" if="invalid" />
      </overlay>
    </column>
  </template>
</templates>
