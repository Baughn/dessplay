<templates version="1">
  <template name="settings-form"><box><overlay class="form-modal" placement="modal"><use template="form"/></overlay></box></template>
  <template name="list-edit-form"><box class="list-edit-form"><overlay class="form-modal" placement="modal"><use template="form"/></overlay></box></template>
  <template name="form-save"><flow id="form-save"><text bind="save-label"/><text bind="save-needs" if="save-blocked"/><text bind="save-hint" if="save-blocked"/></flow></template>
  <template name="form-error"><text id="form-error" bind="error"/></template>
  <template name="form">
    <column id="form" title="title">
      <slot id="form-header" name="header" />
      <scroll id="form-scroll"><slot name="body" /></scroll>
      <slot id="form-notes" name="notes" />
      <slot name="save" />
      <overlay id="form-editor" if="editing">
        <box id="form-editor-frame"><slot name="editor" /></box>
        <slot name="error" if="invalid" />
      </overlay>
    </column>
  </template>
</templates>
